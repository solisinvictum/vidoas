#!/bin/bash
#
# vidoas - safely edit the doas.conf file (like visudo for doas)
#
# 18.08.2022: Updated/forked version of the original one: https://git.sr.ht/~insidepie/vidoas/tree
# Changed the behavior of this script to be exactly like visudo, which NEEDS the user to be root.
#
# Thanks to the original author Joshua Murphy for his initial work https://git.sr.ht/~insidepie/vidoas
#

VERSION="1.2.0"
conf="/etc/doas.conf"
check_only=0
quiet=0
file_given=0

# Colors only when talking to a terminal (and NO_COLOR is not set)
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
	red=$'\033[1;31m'
	green=$'\033[1;32m'
	reset=$'\033[0m'
else
	red=""
	green=""
	reset=""
fi

error() {
	printf '%svidoas: %s%s\n' "$red" "$*" "$reset" >&2
	exit 1
}

warn() {
	printf '%svidoas: %s%s\n' "$red" "$*" "$reset" >&2
}

# Informational messages, hidden by -q
info() {
	[ "$quiet" -eq 1 ] || printf '%s\n' "$*" >&2
}

help() {
	cat - >&2 <<EOF
vidoas - safely edit the doas.conf file (like visudo for doas)

usage: vidoas [-chqsV] [[-f] file]

Options:
  -c, --check		check the file for syntax errors and bad permissions, do not edit
  -f, --file file	edit (or check) file instead of $conf
  -h, --help		display help message and exit
  -q, --quiet		no informational output; with -c only the exit status tells the result
  -s, --strict		accepted for visudo compatibility (doas -C is always strict)
  -V, -v, --version	display version information and exit

Short options can be combined like with visudo, e.g. 'vidoas -cq' or 'vidoas -cf file'.

Environment Variables:
  DOAS_EDITOR	program used to edit files
  EDITOR	program used to edit files if DOAS_EDITOR is unset
  NO_COLOR	disable colored messages

If neither is set, the first of editor, nano, vim and vi that is found is used.
Variables may be missing when running as root via doas: add 'keepenv' (or
'setenv { EDITOR }') to the permit rule, or export EDITOR in root's shell profile.
EOF
}

# Split combined short options like getopt does: -cq -> -c -q,
# -cf file -> -c -f file, -ffile -> -f file
# (the argument after -f/--file is passed on untouched, even if it starts with -)
args=()
need_arg=0
while [ "$#" -ne 0 ]; do
	if [ "$need_arg" -eq 1 ]; then
		args+=("$1")
		need_arg=0
		shift
		continue
	fi
	case "$1" in
		--)
			args+=("$@")
			break
			;;
		--file)
			args+=("$1")
			need_arg=1
			;;
		--*)
			args+=("$1")
			;;
		-?*)
			opts="${1#-}"
			while [ -n "$opts" ]; do
				c="${opts:0:1}"
				opts="${opts:1}"
				if [ "$c" = "f" ]; then
					if [ -n "$opts" ]; then
						args+=(-f "$opts")
						opts=""
					else
						args+=(-f)
						need_arg=1
					fi
				else
					args+=("-$c")
				fi
			done
			;;
		*)
			args+=("$1")
			;;
	esac
	shift
done
set -- "${args[@]}"

set_file() {
	[ "$file_given" -eq 0 ] || { help; error "only one file can be given"; }
	conf="$1"
	file_given=1
}

while [ "$#" -ne 0 ]; do
	case "$1" in
		-c | --check)
			check_only=1
			;;
		-f | --file)
			[ "$#" -ge 2 ] || { help; error "option '$1' requires a file argument"; }
			set_file "$2"
			shift
			;;
		--file=*)
			set_file "${1#--file=}"
			;;
		-q | --quiet)
			quiet=1
			;;
		-s | --strict)
			;;
		--)
			shift
			[ "$#" -le 1 ] || { help; error "only one file can be given"; }
			[ "$#" -eq 0 ] || set_file "$1"
			break
			;;
		-h | --help)
			help
			exit 0
			;;
		-V | -v | --version)
			echo "vidoas version $VERSION"
			exit 0
			;;
		-?*)
			help
			error "invalid option: '$1'"
			;;
		*)
			# visudo style: vidoas [-f] file
			set_file "$1"
			;;
	esac
	shift
done

# -cq: like visudo, only the exit status tells the result, no output at all
if [ "$check_only" -eq 1 ] && [ "$quiet" -eq 1 ]; then
	exec > /dev/null 2>&1
fi

[ -n "$conf" ] || error "empty file name"
# Absolute path: safe for find/mktemp even with names like "-name"
case "$conf" in
	/*) ;;
	*) conf="$PWD/$conf" ;;
esac

# User must be root (because visudo behaves the same way)
if [ "$(id -u)" != 0 ]; then
	error "you need to be root"
fi

command -v doas > /dev/null 2>&1 || error "doas not found in PATH"

# Edit the target of a symlink instead of replacing the link with a file
if [ -L "$conf" ]; then
	target="$(readlink -f -- "$conf")" || error "cannot resolve symlink '$conf'"
	conf="$target"
fi

# doas refuses to run with a config file that is not owned by root
# or that is writable by group or others.
check_perms() {
	local found
	found="$(find "$1" -prune \( ! -user 0 -o -perm -020 -o -perm -002 \) -print 2> /dev/null)" || {
		[ "$quiet" -eq 1 ] || warn "$1: cannot check permissions"
		return 1
	}
	if [ -n "$found" ]; then
		[ "$quiet" -eq 1 ] || warn "$1: bad permissions or owner (doas needs it owned by root and not writable by group/others)"
		return 1
	fi
	return 0
}

if [ "$check_only" -eq 1 ]; then
	if [ "$quiet" -eq 1 ]; then
		# Like visudo -cq: no output, only the exit status
		[ -f "$conf" ] || exit 1
		doas -C "$conf" 2> /dev/null || exit 1
		check_perms "$conf" || exit 1
		exit 0
	fi
	[ -f "$conf" ] || error "$conf: no such file"
	doas -C "$conf" || error "$conf: syntax error, see above"
	check_perms "$conf" || exit 1
	printf '%svidoas: %s: parsed OK%s\n' "$green" "$conf" "$reset"
	exit 0
fi

# Find an editor: DOAS_EDITOR, EDITOR, then common editors
editor_cmd=""
if [ -n "${DOAS_EDITOR:-}" ]; then
	editor_cmd="$DOAS_EDITOR"
elif [ -n "${EDITOR:-}" ]; then
	editor_cmd="$EDITOR"
else
	for editor in editor nano vim vi; do
		if command -v "$editor" > /dev/null 2>&1; then
			editor_cmd="$editor"
			info "vidoas: using '$editor' as editor (set \$EDITOR or \$DOAS_EDITOR to change)"
			break
		fi
	done
fi

[ -n "$editor_cmd" ] || error "no editor found. Please set \$EDITOR or \$DOAS_EDITOR, or install nano/vim/vi"

# Allow editors with arguments, e.g. EDITOR="code --wait"
read -r -a editor_argv <<< "$editor_cmd"
command -v "${editor_argv[0]}" > /dev/null 2>&1 || error "no valid editor command: '$editor_cmd'"

confdir="$(dirname -- "$conf")"
[ -d "$confdir" ] || error "$confdir: no such directory"
if [ -e "$conf" ] && [ ! -f "$conf" ]; then
	error "$conf: not a regular file"
fi

# Lock against a second vidoas running at the same time. The directory is
# locked, not the file: the file is replaced on save (new inode) and may not
# exist yet.
if command -v flock > /dev/null 2>&1; then
	exec 9< "$confdir" || error "cannot open $confdir"
	flock -n 9 || error "$confdir is busy, another vidoas is running"
else
	warn "flock not found, no protection against concurrent edits"
fi

# The temporary file lives next to the real one, so the final mv is atomic
tmp="$(mktemp "$conf.XXXXXX")" || error "cannot create temporary file in $confdir"
trap 'rm -f "$tmp"' EXIT
trap 'exit 1' HUP INT QUIT TERM

if [ -f "$conf" ]; then
	cat -- "$conf" > "$tmp" || error "cannot read $conf"
fi

run_editor() {
	# 9<&-: an editor that leaves a background process must not keep the lock
	if ! "${editor_argv[@]}" "$tmp" 9<&-; then
		error "editor '$editor_cmd' failed, $conf unchanged"
	fi
}

run_editor

# Loop until the config is correct (or the user gives up)
while ! doas -C "$tmp"; do
	warn "$conf not saved because of the error above"
	if [ ! -t 0 ]; then
		error "$conf unchanged"
	fi
	while true; do
		printf 'What now? (e)dit again, e(x)it without saving [e]: ' >&2
		read -r answer || answer="x"
		case "$answer" in
			"" | [eE])
				run_editor
				break
				;;
			[xXqQ])
				echo "vidoas: $conf unchanged" >&2
				exit 1
				;;
			*)
				echo "Options are: (e)dit again, e(x)it without saving" >&2
				;;
		esac
	done
done

# Install if changed
if [ -f "$conf" ] && cmp -s "$tmp" "$conf"; then
	info "vidoas: $conf unchanged"
	exit 0
fi
if [ ! -f "$conf" ] && [ ! -s "$tmp" ]; then
	info "vidoas: $conf unchanged"
	exit 0
fi

chown 0:0 "$tmp" || error "cannot set owner of temporary file, $conf unchanged"
chmod 0400 "$tmp" || error "cannot set mode of temporary file, $conf unchanged"
mv -f -- "$tmp" "$conf" || error "cannot replace $conf"
[ "$quiet" -eq 1 ] || printf '%svidoas: %s saved%s\n' "$green" "$conf" "$reset"
